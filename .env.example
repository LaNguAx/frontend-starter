# Template documenting every environment variable the app reads.
# Copy this file to `.env` (gitignored) and adjust values; `.env.local` also works for personal overrides.
# The app boots without any .env file — schema defaults in src/consts/env.ts cover the baseline.
# IMPORTANT: only VITE_-prefixed variables reach the client bundle — they are PUBLIC. Never put secrets here.

# Base URL for API requests (consumed by the RTK Query base api via src/consts/env.ts)
VITE_API_BASE_URL=/api

# "true" enables MSW request mocking in dev — normally set via `npm run dev:mock` (.env.mock)
VITE_ENABLE_MOCKS=false
